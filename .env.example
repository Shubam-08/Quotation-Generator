# MongoDB Atlas Connection String
# Replace <username>, <password>, <cluster-url>, and <database-name> with your actual values
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/mydatabase?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Database Name (optional - can be included in URI or specified separately)
MONGODB_DB=qlite_quotation
